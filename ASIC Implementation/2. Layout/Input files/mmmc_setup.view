# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_rc_corner -name random_rc_corner -T {125} -preRoute_res {1.0} -preRoute_cap {1.0} -preRoute_clkres {0.0} -preRoute_clkcap {0.0} -postRoute_res {1.0} -postRoute_cap {1.0} -postRoute_xcap {1.0} -postRoute_clkres {0.0} -postRoute_clkcap {0.0}
create_op_cond -name op_Cond -P {10.0} -V {10.0} -T {10.0}
create_library_set -name slow.lib -timing {uk65lscllmvbbr_108c125_wc.lib}
create_constraint_mode -name constraint -sdc_files {syn_constraints.sdc}
create_delay_corner -name max -library_set {slow.lib} -rc_corner {rc_corner}
create_analysis_view -name worst_case -constraint_mode {constraint} -delay_corner {max}
set_analysis_view -setup {worst_case} -hold {worst_case}
